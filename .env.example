# 클라우드 베이스라인용. 로컬 전환 후에는 필요 없음. 쓰는 것만 채운다
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# 에이전트가 쓸 모델. scripts/run_graph_demo.py 가 읽는다
# LLM_PROVIDER: openai | google | ollama
LLM_PROVIDER=openai
LLM_MODEL=

# 로컬 모델
OLLAMA_HOST=http://localhost:11434

# 트레이싱 (8주차 이후)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
