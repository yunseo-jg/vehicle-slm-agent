[
  {
    "name": "set_hvac_temperature",
    "domain": "hvac",
    "description": "Set the cabin temperature for one seat zone. Use when the user asks to change, raise, or lower the temperature. Do not use for fan speed or turning A/C on/off.",
    "parameters": {
      "type": "object",
      "properties": {
        "zone": {
          "type": "string",
          "enum": [
            "driver",
            "passenger",
            "rear"
          ],
          "default": "driver",
          "description": "default: driver"
        },
        "value": {
          "type": "integer",
          "minimum": 16,
          "maximum": 30,
          "description": "unit: Celsius"
        }
      },
      "required": [
        "value"
      ],
      "additionalProperties": false
    },
    "precondition": [
      "power_on"
    ],
    "vss": "Vehicle.Cabin.HVAC.Station.{zone}.Temperature",
    "ext": false
  },
  {
    "name": "set_hvac_fan_speed",
    "domain": "hvac",
    "description": "Set fan speed (0-100 percent) for one seat zone. Use for wind strength requests. Do not use for temperature.",
    "parameters": {
      "type": "object",
      "properties": {
        "zone": {
          "type": "string",
          "enum": [
            "driver",
            "passenger",
            "rear"
          ],
          "default": "driver",
          "description": "default: driver"
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "unit: percent"
        }
      },
      "required": [
        "value"
      ],
      "additionalProperties": false
    },
    "precondition": [
      "power_on"
    ],
    "vss": "Vehicle.Cabin.HVAC.Station.{zone}.FanSpeed",
    "ext": false
  },
  {
    "name": "set_hvac_ac_power",
    "domain": "hvac",
    "description": "Turn the air conditioner on or off. Use when the user asks to turn the A/C on or off. Do not use for temperature or fan speed.",
    "parameters": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false
    },
    "precondition": [
      "power_on"
    ],
    "vss": "Vehicle.Cabin.HVAC.IsAirConditioningActive",
    "ext": false
  },
  {
    "name": "set_hvac_defroster",
    "domain": "hvac",
    "description": "Turn the front windshield defroster on or off. Use when the windshield is fogged or frosted. Do not use for temperature or the air conditioner.",
    "parameters": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false
    },
    "precondition": [
      "power_on"
    ],
    "vss": "Vehicle.Cabin.HVAC.IsFrontDefrosterActive",
    "ext": false
  },
  {
    "name": "set_hvac_seat_heating",
    "domain": "hvac",
    "description": "Set seat heater level (0 off, 100 maximum) for one seat. Use when the user asks for a heated or warm seat. Do not use for cabin temperature.",
    "parameters": {
      "type": "object",
      "properties": {
        "seat": {
          "type": "string",
          "enum": [
            "driver",
            "passenger",
            "rear_left",
            "rear_right"
          ],
          "default": "driver",
          "description": "default: driver"
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "unit: percent"
        }
      },
      "required": [
        "value"
      ],
      "additionalProperties": false
    },
    "precondition": [
      "power_on"
    ],
    "vss": "Vehicle.Cabin.Seat.{seat}.HeatingCooling",
    "ext": false
  },
  {
    "name": "set_media_action",
    "domain": "media",
    "description": "Control media playback: play, stop, skip forward, skip backward. Do not use for volume.",
    "parameters": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "PLAY",
            "STOP",
            "SKIP_FORWARD",
            "SKIP_BACKWARD"
          ]
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    },
    "precondition": [
      "power_on"
    ],
    "vss": "Vehicle.Cabin.Infotainment.Media.Action",
    "ext": false
  },
  {
    "name": "set_media_volume",
    "domain": "media",
    "description": "Set the media playback volume from 0 to 100 percent. Do not use for playback control or vehicle alert volume.",
    "parameters": {
      "type": "object",
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "unit: percent"
        }
      },
      "required": [
        "value"
      ],
      "additionalProperties": false
    },
    "precondition": [
      "power_on"
    ],
    "vss": "Vehicle.Cabin.Infotainment.Media.Volume",
    "ext": false
  },
  {
    "name": "set_media_source",
    "domain": "media",
    "description": "Select the media source for playback. Use only for AM, FM, USB, Bluetooth, or internet media, not for playback actions.",
    "parameters": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "AM",
            "FM",
            "USB",
            "BLUETOOTH",
            "INTERNET"
          ]
        }
      },
      "required": [
        "source"
      ],
      "additionalProperties": false
    },
    "precondition": [
      "power_on"
    ],
    "vss": "Vehicle.Cabin.Infotainment.Media.Played.Source",
    "ext": false
  },
  {
    "name": "get_media_info",
    "domain": "media",
    "description": "Read the album, artist, or track of the media currently playing. Use for media information, not for changing playback.",
    "parameters": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "enum": [
            "album",
            "artist",
            "track"
          ]
        }
      },
      "required": [
        "field"
      ],
      "additionalProperties": false
    },
    "precondition": [
      "power_on"
    ],
    "vss": {
      "album": "Vehicle.Cabin.Infotainment.Media.Played.Album",
      "artist": "Vehicle.Cabin.Infotainment.Media.Played.Artist",
      "track": "Vehicle.Cabin.Infotainment.Media.Played.Track"
    },
    "ext": false
  },
  {
    "name": "set_window_position",
    "domain": "settings",
    "description": "Open or close windows to a position (0 closed, 100 fully open). Use for any request to open, close, lower, or raise a window. Do not use for doors or the sunroof.",
    "parameters": {
      "type": "object",
      "properties": {
        "window": {
          "type": "string",
          "enum": [
            "all",
            "driver",
            "passenger",
            "rear_left",
            "rear_right"
          ],
          "default": "driver",
          "description": "default: driver"
        },
        "position": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "unit: percent"
        }
      },
      "required": [
        "position"
      ],
      "additionalProperties": false
    },
    "precondition": [
      "power_on",
      "speed_below_60"
    ],
    "vss": "Vehicle.Cabin.Door.{window}.Window.Position",
    "ext": false
  },
  {
    "name": "set_door_lock",
    "domain": "settings",
    "description": "Lock or unlock doors. Use when the user asks to lock, unlock, open, or close a car door. Do not use for windows or the trunk.",
    "parameters": {
      "type": "object",
      "properties": {
        "door": {
          "type": "string",
          "enum": [
            "all",
            "driver",
            "passenger",
            "rear"
          ],
          "default": "all",
          "description": "default: all"
        },
        "locked": {
          "type": "boolean"
        }
      },
      "required": [
        "locked"
      ],
      "additionalProperties": false
    },
    "precondition": [],
    "vss": "Vehicle.Cabin.Door.{door}.IsLocked",
    "ext": false
  },
  {
    "name": "set_hazard_lights",
    "domain": "settings",
    "description": "Turn the hazard warning lights on or off. Use when the user mentions hazard lights or an emergency stop signal. Do not use for headlights or turn signals.",
    "parameters": {
      "type": "object",
      "properties": {
        "is_on": {
          "type": "boolean"
        }
      },
      "required": [
        "is_on"
      ],
      "additionalProperties": false
    },
    "precondition": [],
    "vss": "Vehicle.Body.Lights.Hazard.IsSignaling",
    "ext": false
  },
  {
    "name": "set_horn",
    "domain": "settings",
    "description": "Sound or stop the horn. Use when the user asks to honk or press the horn. Do not use for hazard lights or any other sound.",
    "parameters": {
      "type": "object",
      "properties": {
        "is_active": {
          "type": "boolean"
        }
      },
      "required": [
        "is_active"
      ],
      "additionalProperties": false
    },
    "precondition": [],
    "vss": "Vehicle.Body.Horn.IsActive",
    "ext": false
  },
  {
    "name": "get_vehicle_state",
    "domain": "status",
    "description": "Read a vehicle status value such as battery level, range, or speed. Use for questions, not for changing anything.",
    "parameters": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "enum": [
            "battery",
            "range",
            "speed"
          ]
        }
      },
      "required": [
        "field"
      ],
      "additionalProperties": false
    },
    "precondition": [],
    "vss": {
      "battery": "Vehicle.Powertrain.TractionBattery.StateOfCharge.Displayed",
      "range": "Vehicle.Powertrain.Range",
      "speed": "Vehicle.Speed"
    },
    "ext": false
  },
  {
    "name": "search_manual",
    "domain": "phone_manual",
    "description": "Search the owner's manual for explanations of warning lights, features, or maintenance. Use when the user asks what something means or how a feature works.",
    "parameters": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "precondition": [],
    "vss": null,
    "ext": true
  },
  {
    "name": "set_nav_mute",
    "domain": "nav",
    "description": "Mute or unmute the navigation voice guidance. Use when the user wants to silence or restore turn-by-turn spoken directions. Do not use for media or overall volume.",
    "parameters": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "MUTED",
            "ALERT_ONLY",
            "UNMUTED"
          ]
        }
      },
      "required": [
        "state"
      ],
      "additionalProperties": false
    },
    "precondition": [
      "power_on"
    ],
    "vss": "Vehicle.Cabin.Infotainment.Navigation.Mute",
    "ext": false
  },
  {
    "name": "set_nav_volume",
    "domain": "nav",
    "description": "Set the navigation voice guidance volume (0-100 percent). Use for how loud the route guidance speaks. Do not use for media volume or muting.",
    "parameters": {
      "type": "object",
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "unit: percent"
        }
      },
      "required": [
        "value"
      ],
      "additionalProperties": false
    },
    "precondition": [
      "power_on"
    ],
    "vss": "Vehicle.Cabin.Infotainment.Navigation.Volume",
    "ext": false
  },
  {
    "name": "get_nav_location",
    "domain": "nav",
    "description": "Read the vehicle's current location coordinate (latitude or longitude). Use for questions about where the car is now. Not for setting a destination.",
    "parameters": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "enum": [
            "latitude",
            "longitude"
          ]
        }
      },
      "required": [
        "field"
      ],
      "additionalProperties": false
    },
    "precondition": [],
    "vss": {
      "latitude": "Vehicle.CurrentLocation.Latitude",
      "longitude": "Vehicle.CurrentLocation.Longitude"
    },
    "ext": false
  }
]
